# Скопируйте в .env для локальной разработки: cp .env.example .env
# Значения ниже подходят для docker compose и локальной разработки. Секреты сюда не кладём.

NODE_ENV=development
LOG_LEVEL=info

# Порты API и веба. Если порт занят другим проектом, поменяйте его здесь и в DATABASE_URL при необходимости.
API_PORT=4000
WEB_DEV_PORT=5173
WEB_PREVIEW_PORT=4173
WEB_ORIGIN=http://localhost:5173

# Порт веба в docker compose (http://localhost:WEB_PORT).
WEB_PORT=8080

# PostgreSQL (docker compose поднимает базу с этими же данными).
POSTGRES_USER=dzenwriter
POSTGRES_PASSWORD=dzenwriter
POSTGRES_DB=dzenwriter
POSTGRES_PORT=5432
DATABASE_URL=postgres://dzenwriter:dzenwriter@localhost:5432/dzenwriter

# Интеграционные тесты работают в транзакциях с откатом. Можно использовать ту же базу.
TEST_DATABASE_URL=postgres://dzenwriter:dzenwriter@localhost:5432/dzenwriter

# Необязательно: каталог с config/. По умолчанию ищется вверх от кода приложения.
# CONFIG_DIR=
