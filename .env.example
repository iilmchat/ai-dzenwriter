# Скопируйте в .env для локальной разработки: cp .env.example .env
# Значения ниже подходят для docker compose и локальной разработки. Секреты сюда не кладём.

NODE_ENV=development
LOG_LEVEL=info

# Порты API и веба. Если порт занят другим проектом, поменяйте его здесь и в DATABASE_URL при необходимости.
API_PORT=4000
WEB_DEV_PORT=5173
WEB_PREVIEW_PORT=4173
WEB_ORIGIN=http://localhost:5173

# Порт веба в docker compose (http://localhost:WEB_PORT).
WEB_PORT=8080

# Вход через GitHub: OAuth App организации iilmchat. Без секретов вход недоступен, остальное работает.
# Callback URL в настройках OAuth App: ${WEB_ORIGIN}/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=iilmchat
# Логины GitHub через запятую. Получают роль администратора, пока в системе нет ни одного администратора.
ADMIN_GITHUB_LOGINS=iilmchat
# Необязательно: токен с read:org для периодической перепроверки членства (membership:recheck, раз в сутки).
# Без него перепроверка не активна. Подробнее — ADR-0005.
GITHUB_ORG_TOKEN=

# PostgreSQL (docker compose поднимает базу с этими же данными).
POSTGRES_USER=dzenwriter
POSTGRES_PASSWORD=dzenwriter
POSTGRES_DB=dzenwriter
POSTGRES_PORT=5432
DATABASE_URL=postgres://dzenwriter:dzenwriter@localhost:5432/dzenwriter

# Интеграционные тесты работают в транзакциях с откатом. Можно использовать ту же базу.
TEST_DATABASE_URL=postgres://dzenwriter:dzenwriter@localhost:5432/dzenwriter

# Резервные копии: каталог на хосте и срок хранения в днях.
# Каталог не коммитится; в продакшене он должен копироваться за пределы сервера.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14

# Необязательно: каталог с config/. По умолчанию ищется вверх от кода приложения.
# CONFIG_DIR=

# Необязательно: каталог с prompts/. По умолчанию ищется вверх от кода приложения.
# PROMPTS_DIR=

# Провайдер LLM. mock отвечает заглушкой и годится для разработки и CI.
# openai — любой OpenAI-совместимый API; без адреса и ключа генерация не запустится.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Таймаут одного запроса к провайдеру, миллисекунды.
LLM_TIMEOUT_MS=120000

# Суточные лимиты генерации. 0 — без ограничения.
LLM_DAILY_LIMIT_PER_USER=20
LLM_DAILY_BUDGET_USD=5

# Цены провайдера в долларах за миллион токенов: из них считается стоимость материала.
# Возьмите их у провайдера, иначе стоимость в журнале будет нулевой.
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0

# Сколько дней хранить историю запусков generation_runs (retention-скрипт).
GENERATION_RUNS_RETENTION_DAYS=180
