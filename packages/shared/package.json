{
  "name": "@dzenwriter/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Общие константы, схемы конфигурации и контракты API DzenWriter",
  "author": "RuChating (iilmchat)",
  "license": "UNLICENSED",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
